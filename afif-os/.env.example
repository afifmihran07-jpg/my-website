# ---------------------------------------------------------------------------
# Afif OS — environment configuration
# Copy to `.env.local` for local development. Never commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
DATABASE_URL="postgres://postgres@127.0.0.1:5433/afif_os"

# Secret used to derive HMAC signatures for CSRF tokens. >= 32 chars (required).
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Cookie name for the opaque session token.
SESSION_COOKIE="afif_os_session"

# Session lifetime in hours. "Remember me" multiplies this by 30.
SESSION_TTL_HOURS="12"

# Build mode. Note that `next start` forces this to "production" even on
# localhost, so it is no longer what decides the cookie's Secure attribute.
NODE_ENV="development"

# Optional: force the session cookie's Secure attribute on ("true") or off
# ("false"). Leave unset to derive it from the connection — x-forwarded-proto
# when behind a reverse proxy, otherwise the build mode.
#
# This matters because a browser silently DISCARDS a Secure cookie received over
# plain http. If the cookie is dropped, login appears to succeed but every
# protected page bounces back to /login. Set COOKIE_SECURE="false" when running
# `next start` over http on localhost; leave it unset behind HTTPS.
COOKIE_SECURE=""

# Optional: force the session cookie's SameSite attribute to "lax" or "none".
# Leave unset to detect it from the request's Sec-Fetch-Site / Sec-Fetch-Dest
# headers.
#
# SameSite=Lax cookies are NOT sent inside a cross-site iframe — Lax only rides
# along on top-level navigations. So when this app is embedded on another origin
# (a hosted preview pane, say) a Lax cookie is stored by the browser and then
# never sent, which looks exactly like a login that succeeds and immediately
# bounces back to /login. Embedded contexts are detected automatically and get
# SameSite=None (which requires Secure); set this explicitly only if your
# reverse proxy strips the Sec-Fetch-* headers.
COOKIE_SAMESITE=""

# Timezone used when the user has not chosen one yet.
DEFAULT_TIMEZONE="Asia/Dhaka"

# Set to "1" to allow the /setup first-account screen and the dev seed script.
ALLOW_FIRST_USER_SETUP="1"

# Origins allowed to invoke Server Actions when the browser's Origin does not
# match the Host the app sees. Needed behind a reverse proxy that does not
# rewrite Host (a hosted preview pane, for example): without it Next aborts
# EVERY server action with a 500, including login.
# Comma-separated; wildcards allowed. `allowedDevOrigins` does not cover this —
# it only applies to `next dev`, not `next start`.
SERVER_ACTION_ALLOWED_ORIGINS="*.e2b.app,localhost,127.0.0.1"

# Optional: shared secret for the cron endpoint POST /api/tick, which runs the
# reminder engine on a schedule. Min 16 characters. When unset the endpoint
# refuses to run instead of becoming an unauthenticated mutation path.
# Generate one with: openssl rand -hex 32
REMINDER_TICK_TOKEN=""

# Optional: OpenAI-compatible endpoint for the AI Advisor (Phase 9).
# When unset the advisor runs in deterministic rule mode only.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL=""
